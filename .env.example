# Copy this file to .env.local (never committed) and fill in the values.
# Only public values belong here: everything NEXT_PUBLIC_* ends up in the browser.

# Sub-path the site is served from. Leave empty for local development.
# On GitHub Pages the deploy workflow sets it automatically (e.g. /o-mega).
NEXT_PUBLIC_BASE_PATH=

# Supabase → Project Settings → API: Project URL and publishable key
# (the legacy "anon" key works too). NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
